    <string name="outcome_nfc_not_available_title">NFC indisponible</string>
    <string name="outcome_nfc_not_available">Ce téléphone n’a pas de lecteur NFC : la puce ne peut pas être lue.</string>
    <string name="outcome_nfc_disabled_title">Le NFC est désactivé</string>
    <string name="outcome_nfc_disabled">Activez le NFC dans les paramètres du système, puis réessayez.</string>
    <string name="outcome_card_removed_title">Carte éloignée</string>
    <string name="outcome_card_removed">La carte a quitté la zone de lecture avant la fin. Posez-la à plat contre le dos du téléphone et ne la bougez plus jusqu’à la fin.</string>
    <string name="outcome_iso_dep_unavailable_title">Carte non compatible</string>
    <string name="outcome_iso_dep_unavailable">Cette carte ne prend pas en charge le protocole ISO-DEP nécessaire à la lecture des données d’identité.</string>
    <string name="outcome_application_not_found_title">Application d’identité introuvable</string>
    <string name="outcome_application_not_found">La carte n’a pas répondu à l’application d’identité ICAO standard. Il ne s’agit peut-être pas d’un document compatible ICAO.</string>
    <string name="outcome_protocol_unsupported_title">Protocole non pris en charge</string>
    <string name="outcome_protocol_unsupported">La carte utilise un protocole d’accès ou des paramètres que SAMTEX ne peut pas exécuter. Aucune donnée n’a été lue.</string>
    <string name="outcome_access_credentials_required_title">Informations de la carte requises</string>
    <string name="outcome_access_credentials_required">Saisissez le numéro, la date de naissance et la date d’expiration imprimés sur la carte pour déverrouiller la puce.</string>
    <string name="outcome_authentication_failed_title">Données d’accès refusées</string>
    <string name="outcome_authentication_failed">La puce a refusé les données d’accès. Vérifiez le numéro, la date de naissance et la date d’expiration tels qu’imprimés sur la carte. Aucune autre tentative n’a été faite.</string>
    <string name="outcome_access_denied_title">Accès refusé</string>
    <string name="outcome_access_denied">La puce a refusé l’accès à ces données. Elles exigent une autorisation dont SAMTEX ne dispose pas.</string>
    <string name="outcome_file_not_found_title">Données introuvables</string>
    <string name="outcome_file_not_found">Le fichier d’identité requis (DG1) est absent de la puce.</string>
    <string name="outcome_data_format_unsupported_title">Format de données non pris en charge</string>
    <string name="outcome_data_format_unsupported">Les données ont été lues mais ne suivent pas le format ICAO documenté ; elles n’ont pas été interprétées.</string>
    <string name="outcome_verification_unavailable_title">Authenticité non vérifiée</string>
    <string name="outcome_verification_unavailable">Les données ont été lues, mais leur authenticité n’a pas pu être vérifiée faute de certificat national de confiance (CSCA). Des données lisibles ne sont pas forcément authentiques.</string>
    <string name="outcome_reading_successful_title">Lecture réussie</string>
    <string name="outcome_reading_successful">Les données d’identité ont été lues sur la puce après une authentification d’accès réussie.</string>
