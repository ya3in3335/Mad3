    <string name="action_read_identity">Lire la carte d’identité</string>
    <string name="access_title">Accès sécurisé</string>
    <string name="access_intro">Les données d’identité de la puce sont protégées. Saisissez les informations imprimées sur votre carte : elles servent uniquement à déverrouiller la puce (ICAO BAC/PACE) et sont effacées juste après la lecture. Elles ne sont jamais stockées ni envoyées.</string>
