    <string name="outcome_nfc_not_available">This phone has no NFC reader, so the chip cannot be read.</string>
    <string name="outcome_nfc_disabled_title">NFC is turned off</string>
    <string name="outcome_nfc_disabled">Turn on NFC in the system settings, then try again.</string>
    <string name="outcome_card_removed_title">Card moved away</string>
    <string name="outcome_card_removed">The card left the reading area before the end. Place it flat against the back of the phone and keep it still until reading is complete.</string>
    <string name="outcome_iso_dep_unavailable_title">Card not compatible</string>
    <string name="outcome_iso_dep_unavailable">This card does not support the ISO-DEP smart-card protocol needed to read identity data.</string>
    <string name="outcome_application_not_found_title">Identity application not found</string>
    <string name="outcome_application_not_found">The card did not answer to the standard ICAO identity application. It may not be an ICAO-compatible document.</string>
    <string name="outcome_protocol_unsupported_title">Protocol not supported</string>
    <string name="outcome_protocol_unsupported">The card uses an access protocol or parameters that SAMTEX cannot execute. No data was read.</string>
    <string name="outcome_access_credentials_required_title">Card details required</string>
    <string name="outcome_access_credentials_required">Enter the card number, date of birth and expiry date printed on the card to unlock the chip.</string>
    <string name="outcome_authentication_failed_title">Access data rejected</string>
    <string name="outcome_authentication_failed">The chip rejected the access data. Check the card number, date of birth and expiry date exactly as printed on the card. No other attempt was made.</string>
    <string name="outcome_access_denied_title">Access denied</string>
    <string name="outcome_access_denied">The chip refused access to this data. It requires an authorization that SAMTEX does not have.</string>
    <string name="outcome_file_not_found_title">Data not found</string>
    <string name="outcome_file_not_found">The required identity file (DG1) is not present on the chip.</string>
    <string name="outcome_data_format_unsupported_title">Unsupported data format</string>
    <string name="outcome_data_format_unsupported">The data was read but does not follow the documented ICAO format, so it was not interpreted.</string>
    <string name="outcome_verification_unavailable_title">Authenticity not verified</string>
    <string name="outcome_verification_unavailable">The data was read, but its authenticity could not be verified because no trusted country certificate (CSCA) is installed. Readable data is not necessarily genuine.</string>
    <string name="outcome_reading_successful_title">Reading successful</string>
    <string name="outcome_reading_successful">The identity data was read from the chip after successful access authentication.</string>
